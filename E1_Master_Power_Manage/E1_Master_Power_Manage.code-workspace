{
	"folders": [
		{ "path": ".", "name": "0_Project 根目录" },
		{ "path": "tasks", "name": "1_Tasks 任务层" },
		{ "path": "applications", "name": "2_Applications 应用层" },
		{ "path": "service", "name": "3_Services 服务层" },
