		{ "path": "device_drivers", "name": "5_DeviceDrivers 驱动层" },
		{ "path": "../public_layer/device_drivers/hal_flash", "name": "5b_SharedDeviceDrivers (public_layer)" },
		{ "path": "Core", "name": "6_HAL_CubeMX" },
