	"settings": {
		"files.exclude": {
			"tasks": true,
			"applications": true,
			"service": true,
			"device_drivers": true,
			"Core": true,
			"Drivers": true,
			"cmake": true,
			"docs": true,
			"build": true,
			"**/CMakeFiles": true,
			"**/*.o": true,
			"**/*.d": true
